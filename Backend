from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import yfinance as yf
import pandas as pd
from sklearn.ensemble import IsolationForest
import numpy as np
from functools import lru_cache
import hashlib

app = FastAPI()

# ✅ Allow frontend (Lovable/React) to call backend
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],   # change "*" to your frontend URL in production
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Request schema
class StockRequest(BaseModel):
    symbol: str
    start_date: str
    end_date: str

# Cache for stock data to avoid repeated API calls
@lru_cache(maxsize=128)
def fetch_stock_data(symbol: str, start: str, end: str):
    """Cached wrapper for yfinance download to avoid redundant API calls."""
    data = yf.download(symbol, start=start, end=end, progress=False)
    return data

# Cache for trained models to avoid retraining on every request
_model_cache = {}

def get_or_train_model(data_hash: str, features):
    """Get cached model or train a new one if not exists."""
    if data_hash not in _model_cache:
        model = IsolationForest(contamination=0.02, random_state=42)
        model.fit(features)
        _model_cache[data_hash] = model
    return _model_cache[data_hash]

# Helper: detect anomalies
def detect_anomalies(symbol: str, start: str, end: str):
    data = fetch_stock_data(symbol, start, end)
    if data.empty:
        return []

    # Validate minimum dataset size for meaningful analysis
    if len(data) < 15:
        return []

    # Calculate features with optimized rolling operations
    data["Return"] = data["Close"].pct_change()
    data["Volatility"] = data["Return"].rolling(10).std()
    
    # Cache rolling operations to avoid redundant calculations
    volume_rolling = data["Volume"].rolling(10)
    volume_mean = volume_rolling.mean()
    volume_std = volume_rolling.std()
    data["Volume_z"] = (data["Volume"] - volume_mean) / volume_std

    features = data[["Return", "Volatility", "Volume_z"]].dropna()
    if features.empty:
        return []

    # Use cached model to avoid retraining
    data_hash = hashlib.md5(f"{symbol}_{start}_{end}".encode()).hexdigest()
    model = get_or_train_model(data_hash, features)
    anomalies = model.predict(features)

    # Efficiently assign anomaly results to original dataframe
    data.loc[features.index, "Anomaly"] = anomalies
    data["Anomaly"].fillna(0, inplace=True)
    
    result = data.reset_index()
    result_json = result[
        ["Date", "Open", "High", "Low", "Close", "Volume", "Anomaly"]
    ]
    result_json = result_json.replace({np.nan: None})
    return result_json.to_dict(orient="records")

# API endpoint
@app.post("/detect")
def detect_stock_anomalies(request: StockRequest):
    data = detect_anomalies(request.symbol, request.start_date, request.end_date)
    return {
        "symbol": request.symbol,
        "start_date": request.start_date,
        "end_date": request.end_date,
        "anomalies": data
    }

